# ── Application ──────────────────────────────────────────────────
APP_NAME=Cyber Evidence Vault
APP_ENV=development

# ── Database (Supabase PostgreSQL) ───────────────────────────────
# Format: postgresql+psycopg2://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# ── JWT Authentication ────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── AES-256-GCM File Encryption ──────────────────────────────────
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# WARNING: Never change this after uploading evidence — files become unrecoverable!
ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# ── Admin / Vault Owner Account ──────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_PASSWORD=YourSecurePassword123!

# ── Frontend URL (for CORS) ───────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Brevo Email API (Primary — sends OTP to ANY email address) ───
# Sign up: https://app.brevo.com → API Keys → Generate
BREVO_API_KEY=xkeysib-YOUR_BREVO_API_KEY_HERE
BREVO_SENDER_EMAIL=your-verified-sender@gmail.com
BREVO_SENDER_NAME=Cyber Evidence Vault

# ── Resend API (Fallback — free tier sends to own email only) ────
# Sign up: https://resend.com → API Keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# ── SMTP (Second Fallback — optional) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
