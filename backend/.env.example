APP_NAME=Cyber Evidence Vault
APP_ENV=development

# Supabase PostgreSQL Database URL
# Format (Direct Connection):
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres
# Format (Connection Pooler):
# DATABASE_URL=postgresql+psycopg2://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
ENCRYPTION_KEY=REPLACE_WITH_A_BASE64_32_BYTE_KEY
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
FRONTEND_URL=http://localhost:5173
